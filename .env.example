# ---- Cashfree Payments ----
# Get SANDBOX keys instantly (no approval needed) from:
# https://merchant.cashfree.com  -> Developers -> API Keys -> Test Mode
CASHFREE_APP_ID=your_app_id_here
CASHFREE_SECRET_KEY=your_secret_key_here
# SANDBOX for testing today. Switch to PRODUCTION only after Cashfree approves your live account.
CASHFREE_ENV=SANDBOX
CASHFREE_API_VERSION=2025-01-01

# ---- Email delivery (Resend) ----
# https://resend.com -> verify thecozycorner.in as a sending domain -> create an API key
RESEND_API_KEY=your_resend_api_key_here
FROM_EMAIL=orders@thecozycorner.in

# ---- Site ----
# Used to build the Cashfree return_url. Use your live domain once deployed.
SITE_URL=http://localhost:3000
PORT=3000
